# VULCAN secrets — copy to .env and fill in (NEVER commit .env)
ALPACA_API_KEY=your_alpaca_paper_key_id
ALPACA_SECRET=your_alpaca_secret_key
ALPACA_PAPER=true

# Cloudflare (dashboard hosting + Workers AI brain)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
VULCAN_DASH_URL=https://your-worker.your-subdomain.workers.dev

# Optional: Z.ai direct API (falls back to Cloudflare Workers AI)
Z_AI_API_KEY=

